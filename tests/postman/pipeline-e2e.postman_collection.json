{
  "info": {
    "name": "Verificación integral del procesamiento PDF",
    "description": "Verifica el recorrido del PDF desde la creación hasta la descarga del texto extraído.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "https://api.localhost" },
    { "key": "s3_base_url", "value": "https://s3.localhost" },
    { "key": "doc_id", "value": "" },
    { "key": "upload_url", "value": "" },
    { "key": "upload_form_fields", "value": "{}" },
    { "key": "upload_headers", "value": "{}" },
    { "key": "poll_attempts", "value": "0" }
  ],
  "item": [
    {
      "name": "0. Verificación básica",
      "item": [
        { "name": "Comprobar disponibilidad del gateway", "request": { "method": "GET", "url": "{{base_url}}/healthz", "description": "Comprueba que el gateway responde." }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Responde con 200', function () { pm.response.to.have.status(200); });"] } }] },
        { "name": "Listar documentos", "request": { "method": "GET", "url": "{{base_url}}/api/v2/documents", "description": "Comprueba el endpoint de listado." }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Responde con 200', function () { pm.response.to.have.status(200); });", "pm.test('Devuelve un objeto JSON', function () { pm.expect(pm.response.json()).to.be.an('object'); });"] } }] }
      ]
    },
    {
      "name": "1. Recorrido correcto",
      "item": [
        { "name": "Crear documento PDF", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"idempotency_key\": \"pm-{{$guid}}\",\n  \"size_bytes\": 453\n}", "options": { "raw": { "language": "json" } } }, "url": "{{base_url}}/api/v2/documents", "description": "Crea un documento y conserva los datos de la carga firmada." }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Documento creado con 201', function () { pm.response.to.have.status(201); });", "const data = pm.response.json();", "pm.collectionVariables.set('doc_id', data.document_id);", "pm.collectionVariables.set('upload_url', data.upload_url);", "pm.collectionVariables.set('upload_form_fields', JSON.stringify(data.form_fields));", "pm.collectionVariables.set('upload_headers', JSON.stringify(data.required_headers));", "Object.keys(data.form_fields || {}).forEach(function (key) { pm.collectionVariables.set('fm_' + key, data.form_fields[key]); });", "Object.keys(data.required_headers || {}).forEach(function (key) { pm.collectionVariables.set('hv_' + key, data.required_headers[key]); });", "pm.test('Respuesta incluye campos para cargar', function () { pm.expect(data.document_id).to.be.a('string'); pm.expect(data.upload_url).to.be.a('string'); pm.expect(data.form_fields).to.be.an('object'); });"] } }] },
        { "name": "Subir PDF directamente a MinIO", "request": { "method": "POST", "header": [{ "key": "{{hv_Content-Type}}", "value": "{{hv_Content-Type}}", "disabled": true }], "body": { "mode": "formdata", "formdata": [
          { "key": "key", "value": "{{fm_key}}", "type": "text" }, { "key": "policy", "value": "{{fm_policy}}", "type": "text" }, { "key": "x-amz-algorithm", "value": "{{fm_x-amz-algorithm}}", "type": "text" }, { "key": "x-amz-credential", "value": "{{fm_x-amz-credential}}", "type": "text" }, { "key": "x-amz-date", "value": "{{fm_x-amz-date}}", "type": "text" }, { "key": "x-amz-signature", "value": "{{fm_x-amz-signature}}", "type": "text" }, { "key": "file", "type": "file", "src": "fixtures/minimal.pdf" }
        ] }, "url": "{{upload_url}}", "description": "Sube el archivo directamente a MinIO. El campo file debe ser el último; añada filas de texto si form_fields devuelve otros campos." }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('MinIO acepta la carga (2xx)', function () { pm.expect(pm.response.code).to.be.within(200, 299); });"] } }] },
        { "name": "Esperar extracción", "request": { "method": "GET", "url": "{{base_url}}/api/v2/documents/{{doc_id}}", "description": "Consulta el estado; el Runner vuelve a ejecutar esta solicitud mientras el proceso está activo." }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const data = pm.response.json();", "const terminal = ['COMPLETED', 'FAILED', 'REJECTED', 'UPLOAD_EXPIRED'];", "pm.test('Estado consultado con 200', function () { pm.response.to.have.status(200); });", "pm.test('Estado pertenece al contrato', function () { pm.expect(['PENDING_UPLOAD','UPLOADED','QUEUED','PROCESSING','RETRYING','EXTRACTION_FAILED','COMPENSATING','COMPLETED','FAILED','REJECTED','UPLOAD_EXPIRED']).to.include(data.status); });", "if (!terminal.includes(data.status) && Number(pm.collectionVariables.get('poll_attempts')) < 30) {", "  pm.collectionVariables.set('poll_attempts', String(Number(pm.collectionVariables.get('poll_attempts')) + 1));", "  if (pm.execution && pm.execution.setNextRequest) pm.execution.setNextRequest(pm.info.requestName); else postman.setNextRequest(pm.info.requestName);", "} else if (terminal.includes(data.status)) {", "  pm.collectionVariables.set('poll_attempts', '0');", "  pm.test('La extracción terminó correctamente', function () { pm.expect(data.status).to.eql('COMPLETED'); });", "}"] } }] },
        { "name": "Obtener enlace del texto", "request": { "method": "GET", "url": "{{base_url}}/api/v2/documents/{{doc_id}}/download", "description": "Solicita el enlace prefirmado del texto extraído." }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const data = pm.response.json();", "pm.test('Descarga disponible con 200', function () { pm.response.to.have.status(200); });", "pm.test('Incluye URL de descarga no vacía', function () { pm.expect(data.download_url).to.be.a('string').and.not.empty; });"] } }] }
      ]
    },
    {
      "name": "2. Casos negativos",
      "item": [
        { "name": "Crear carga de texto no PDF", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"idempotency_key\":\"pm-not-pdf-{{$guid}}\",\"size_bytes\":40}", "options": { "raw": { "language": "json" } } }, "url": "{{base_url}}/api/v2/documents", "description": "Prepara el documento para la prueba de rechazo no-PDF." }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Documento creado con 201', function () { pm.response.to.have.status(201); });", "const data = pm.response.json(); pm.collectionVariables.set('doc_id', data.document_id); pm.collectionVariables.set('upload_url', data.upload_url);", "Object.keys(data.form_fields || {}).forEach(function (key) { pm.collectionVariables.set('fm_' + key, data.form_fields[key]); });"] } }] },
        { "name": "Subir archivo de texto", "request": { "method": "POST", "body": { "mode": "formdata", "formdata": [{ "key": "key", "value": "{{fm_key}}", "type": "text" }, { "key": "policy", "value": "{{fm_policy}}", "type": "text" }, { "key": "x-amz-algorithm", "value": "{{fm_x-amz-algorithm}}", "type": "text" }, { "key": "x-amz-credential", "value": "{{fm_x-amz-credential}}", "type": "text" }, { "key": "x-amz-date", "value": "{{fm_x-amz-date}}", "type": "text" }, { "key": "x-amz-signature", "value": "{{fm_x-amz-signature}}", "type": "text" }, { "key": "file", "type": "file", "src": "fixtures/not-a-pdf.txt" }] }, "url": "{{upload_url}}", "description": "Adjunte fixtures/not-a-pdf.txt al campo file; debe permanecer como último campo." }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('MinIO acepta la carga de prueba (2xx)', function () { pm.expect(pm.response.code).to.be.within(200, 299); });"] } }] },
        { "name": "Verificar rechazo no-PDF", "request": { "method": "GET", "url": "{{base_url}}/api/v2/documents/{{doc_id}}", "description": "Consulte repetidamente hasta un estado terminal." }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const data = pm.response.json(); const terminal = ['COMPLETED','FAILED','REJECTED','UPLOAD_EXPIRED'];", "pm.test('Estado consultado con 200', function () { pm.response.to.have.status(200); });", "if (!terminal.includes(data.status) && Number(pm.collectionVariables.get('poll_attempts')) < 30) { pm.collectionVariables.set('poll_attempts', String(Number(pm.collectionVariables.get('poll_attempts')) + 1)); if (pm.execution && pm.execution.setNextRequest) pm.execution.setNextRequest(pm.info.requestName); else postman.setNextRequest(pm.info.requestName); } else { pm.collectionVariables.set('poll_attempts', '0'); pm.test('El archivo no PDF queda REJECTED', function () { pm.expect(data.status).to.eql('REJECTED'); pm.expect(data.failure_reason).to.eql('NOT_A_PDF'); }); }"] } }] },
        { "name": "Crear con clave de idempotencia fija (primera llamada)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"idempotency_key\":\"pm-idem-fixed\",\"size_bytes\":453}", "options": { "raw": { "language": "json" } } }, "url": "{{base_url}}/api/v2/documents", "description": "Primera llamada del par idempotente." }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Primera llamada responde 201', function () { pm.response.to.have.status(201); });", "pm.collectionVariables.set('idem_doc_id', pm.response.json().document_id);"] } }] },
        { "name": "Repetir clave de idempotencia fija", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"idempotency_key\":\"pm-idem-fixed\",\"size_bytes\":453}", "options": { "raw": { "language": "json" } } }, "url": "{{base_url}}/api/v2/documents", "description": "La repetición debe devolver el mismo documento." }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const data = pm.response.json();", "pm.test('Repetición responde 200', function () { pm.response.to.have.status(200); });", "pm.test('Devuelve el mismo documento', function () { pm.expect(data.document_id).to.eql(pm.collectionVariables.get('idem_doc_id')); });"] } }] },
        { "name": "Rechazar tamaño excesivo", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"idempotency_key\":\"pm-too-large-{{$guid}}\",\"size_bytes\":999999999999}", "options": { "raw": { "language": "json" } } }, "url": "{{base_url}}/api/v2/documents", "description": "Solicita un tamaño por encima del límite configurado." }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Tamaño excesivo responde 400', function () { pm.response.to.have.status(400); });", "pm.test('Error usa application/problem+json', function () { pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json'); pm.expect(pm.response.json()).to.have.property('status', 400); });"] } }] },
        { "name": "Crear documento para probar descarga prematura", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"idempotency_key\":\"pm-early-download-{{$guid}}\",\"size_bytes\":453}", "options": { "raw": { "language": "json" } } }, "url": "{{base_url}}/api/v2/documents", "description": "Crea un documento que todavía no se ha cargado." }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Documento creado con 201', function () { pm.response.to.have.status(201); });", "pm.collectionVariables.set('early_doc_id', pm.response.json().document_id);"] } }] },
        { "name": "Rechazar descarga antes de completar", "request": { "method": "GET", "url": "{{base_url}}/api/v2/documents/{{early_doc_id}}/download", "description": "Una descarga no está disponible antes de COMPLETED." }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Descarga prematura responde 409', function () { pm.response.to.have.status(409); });", "pm.test('Error usa application/problem+json', function () { pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json'); });"] } }] }
      ]
    },
    {
      "name": "3. Límite de solicitudes (Runner)",
      "item": [{ "name": "Observar respuesta del límite", "request": { "method": "GET", "url": "{{base_url}}/api/v2/documents", "description": "Ejecute al menos 30 iteraciones con Runner o Newman para observar el rate limit." }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('La respuesta es 200 o 429', function () { pm.expect([200, 429]).to.include(pm.response.code); });", "if (pm.response.code === 429) { console.warn('Se observó el límite de solicitudes (429).'); pm.test('429 informa espera mediante Retry-After o X-RateLimit-*', function () { const names = pm.response.headers.all().map(function (h) { return h.key.toLowerCase(); }); pm.expect(names.some(function (name) { return name === 'retry-after' || name.indexOf('x-ratelimit-') === 0; })).to.eql(true); }); }"] } }] }]
    }
  ]
}
